# Copy to .env.local for local development (.env.local is git-ignored).
#
# On Vercel these are set as Sensitive variables for Production and Preview,
# so `vercel env pull` cannot download them; paste the values here once.

# Firebase web app config: Firebase console > Project settings > General >
# Your apps > (web app) > SDK setup and configuration > Config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend API. Use http://localhost:8000 when running the FastAPI backend
# locally, or https://api.citey.email to use production (that backend must
# list http://localhost:3000 in ALLOWED_ORIGINS for the browser to call it).
NEXT_PUBLIC_API_URL=http://localhost:8000
