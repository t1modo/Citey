# Copy to .env.local for local development (.env.local is git-ignored).
#
# On Vercel these are set as Sensitive variables for Production and Preview,
# so `vercel env pull` cannot download them; paste the values here once.

# Firebase web app config: Firebase console > Project settings > General >
# Your apps > (web app) > SDK setup and configuration > Config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend API base, including the /api prefix every backend route uses.
# Locally (Docker or uvicorn): http://localhost:8000/api. On Vercel, where the
# site and API deploy as one project, set it to /api. To use production from
# a local site: https://www.citey.email/api (that backend must list
# http://localhost:3000 in ALLOWED_ORIGINS).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# PostHog analytics (optional). Project token and ingestion host from
# PostHog > Project settings. Leave empty to disable analytics locally.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
