{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "src.app.main:app",
      "functions": {
        "src/app/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{tests/**,scripts/**,.venv/**,Dockerfile,.dockerignore,.env.example}"
        }
      }
    },
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    }
  },
  "redirects": [
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "api.citey.email"
        }
      ],
      "destination": "https://www.citey.email/api/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "api.citey.email"
        }
      ],
      "destination": "https://www.citey.email/api/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
