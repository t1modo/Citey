# Copy to backend/.env (git-ignored). `docker compose up` and `uv run uvicorn
# main:app` both read it.

# Firebase Admin. Paste the whole service account JSON on one line
# (Firebase console > Project settings > Service accounts > Generate new
# private key). Docker can't see a key file on your disk, so use this rather
# than FIREBASE_SERVICE_ACCOUNT_PATH when running in Compose.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email via Resend. Leave empty to skip sending.
RESEND_API_KEY=

# Jobs and signed links. Any long random string works locally.
CRON_SECRET=
TOKEN_SECRET=

# The in-process nightly scheduler emails real users from whatever Firestore
# you point at. Production drives jobs from GitHub Actions instead.
DISABLE_SCHEDULER=true

# Optional API keys (see README).
ANTHROPIC_API_KEY=
S2_API_KEY=
OPENALEX_API_KEY=
OPENCITATIONS_ACCESS_TOKEN=
ADS_API_KEY=
