# Copy to backend/.env (git-ignored). `docker compose up` and `uv run uvicorn
# main:app` both read it.

# Firebase Admin. Paste the whole service account JSON on one line
# (Firebase console > Project settings > Service accounts > Generate new
# private key). Docker can't see a key file on your disk, so use this rather
# than FIREBASE_SERVICE_ACCOUNT_PATH when running in Compose.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email via Resend. Leave empty to skip sending.
RESEND_API_KEY=

# Jobs and signed links. Any long random string works locally.
CRON_SECRET=
TOKEN_SECRET=

# Public origin of the site and API, without /api. Links in emails use it,
# and the backend adds /api itself. Production: https://www.citey.email
API_URL=http://localhost:8000

# --- Inngest: runs the nightly citation check, the daily cleanup and the
# weekly publication sync. The functions are served at /api/inngest.
#
# Local: keep INNGEST_DEV=1 and leave the keys empty. `docker compose up`
# starts the Inngest Dev Server at http://localhost:8288, where you can see
# the functions and run one by hand. (Without Docker, run
# `npx inngest-cli@latest dev -u http://localhost:8000/api/inngest`.)
# The functions use whatever Firestore this file points at, so running
# one locally can write real notifications.
#
# Production (Inngest Cloud), set these in the Vercel project, not here:
#   1. app.inngest.com > the Citey org > Production environment.
#   2. Manage > Signing Key: copy it into INNGEST_SIGNING_KEY.
#   3. Manage > Event Keys > Create Event Key: copy it into INNGEST_EVENT_KEY.
#   4. Set INNGEST_SERVE_ORIGIN=https://www.citey.email and leave INNGEST_DEV
#      unset. Redeploy.
#   5. Apps > Sync new app > https://www.citey.email/api/inngest. Five
#      functions appear. Resync after a deploy that adds, removes or
#      reschedules a function (Resync in the dashboard, or
#      `curl -X PUT https://www.citey.email/api/inngest`).
# Without INNGEST_SIGNING_KEY in production the API still runs but leaves
# /api/inngest out and logs an error, so no scheduled jobs run.
INNGEST_DEV=1
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
INNGEST_SERVE_ORIGIN=

# The in-process nightly scheduler emails real users from whatever Firestore
# you point at. Production runs the jobs on Inngest instead.
DISABLE_SCHEDULER=true

# Where contact form messages are sent. Empty means SUPPORT_EMAIL
# (support@citey.email), which reaches the owner through a forwarder that can
# hold or drop mail. Production sets the owner's inbox here.
SUPPORT_INBOX=

# Neon Postgres (project "citey" in the Citey org). `neon deploy` at the
# repo root writes both into .env.local. DATABASE_URL is the pooled string
# for the app; DATABASE_URL_UNPOOLED is the direct one, for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional API keys (see README).
ANTHROPIC_API_KEY=
S2_API_KEY=
OPENALEX_API_KEY=
OPENCITATIONS_ACCESS_TOKEN=
ADS_API_KEY=
